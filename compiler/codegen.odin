package main

import "core:fmt"
import "core:strings"

/*
A lexical scope of the generated procedure.

`{code}` is compiled to a nested procedure, and Odin procedures cannot capture
local variables. Each scope containing code therefore snapshots every visible
variable into an `_EnvN` struct, which is handed to the code procedures.
*/
Scope :: struct {
	vars:     [dynamic]string, // every variable visible in the scope
	env_type: string,          // empty when the scope needs no snapshot
	env_var:  string,
}

Gen :: struct {
	sb:      strings.Builder,
	indent:  int,
	counter: int,
	scopes:  [dynamic]Scope,
	dir:     string, // name of the directory of the templates, for comments
	file:    string, // base name of the template being generated, for comments
}

// Generates the Odin source for all the templates of one directory.
generate :: proc(templates: []^Template, source_dir, package_name, import_path: string) -> string {
	g := Gen{dir = source_dir}
	fmt.sbprintf(&g.sb, "// Code generated by frigg from %s/*.frigg. DO NOT EDIT.\n", source_dir)
	fmt.sbprintf(&g.sb, "package %s\n\n", package_name)
	fmt.sbprintf(&g.sb, "import frigg %s\n", quote(import_path))
	imports: [dynamic]string
	for tmpl in templates {
		for imp in tmpl.imports {
			if !contains(imports[:], imp) {
				append(&imports, imp)
				fmt.sbprintf(&g.sb, "%s\n", imp)
			}
		}
	}
	for tmpl in templates {
		gen_template(&g, tmpl)
	}
	return strings.to_string(g.sb)
}

gen_template :: proc(g: ^Gen, tmpl: ^Template) {
	g.file = base_name(tmpl.path)
	g.counter = 0
	clear(&g.scopes)

	args := tmpl.args
	// A template can declare its own `allocator` argument.
	if !contains(tmpl.arg_names[:], "allocator") {
		args = strings.concatenate({args, ", " if args != "" else "", "allocator := context.temp_allocator"})
	}

	emit(g, "")
	emit(g, "// Generated from %s/%s", g.dir, g.file)
	emit(g, "%s :: proc(%s) -> frigg.Template {{", tmpl.name, args)
	g.indent += 1
	open_scope(g, tmpl.arg_names[:], tmpl.nodes[:])
	list := gen_list(g, tmpl.nodes[:])
	emit(g, "return frigg.Template{{%s, %s}}", quote(tmpl.name), list)
	close_scope(g)
	g.indent -= 1
	emit(g, "}}")
}

// Writes one line of generated code at the current indentation.
emit :: proc(g: ^Gen, format: string, args: ..any) {
	if format != "" {
		for _ in 0 ..< g.indent {
			strings.write_byte(&g.sb, '\t')
		}
		fmt.sbprintf(&g.sb, format, ..args)
	}
	strings.write_byte(&g.sb, '\n')
}

next_id :: proc(g: ^Gen) -> int {
	defer g.counter += 1
	return g.counter
}

open_scope :: proc(g: ^Gen, new_vars: []string, body: []Node) {
	scope: Scope
	if len(g.scopes) > 0 {
		append(&scope.vars, ..g.scopes[len(g.scopes) - 1].vars[:])
	}
	for name in new_vars {
		if !contains(scope.vars[:], name) {
			append(&scope.vars, name)
		}
	}
	if len(scope.vars) > 0 && has_direct_code(body) {
		id := next_id(g)
		scope.env_type = fmt.aprintf("_Env%d", id)
		scope.env_var = fmt.aprintf("_env%d", id)
		emit(g, "%s :: struct {{", scope.env_type)
		for name in scope.vars {
			emit(g, "\t%s: type_of(%s),", name, name)
		}
		emit(g, "}}")
		fields: strings.Builder
		for name, i in scope.vars {
			fmt.sbprintf(&fields, "%s%s = %s", ", " if i > 0 else "", name, name)
		}
		emit(g, "%s := new_clone(%s{{%s}}, allocator)", scope.env_var, scope.env_type, strings.to_string(fields))
	}
	append(&g.scopes, scope)
}

close_scope :: proc(g: ^Gen) {
	pop(&g.scopes)
}

/*
Reports whether `nodes` contain code that runs in the current scope, as
opposed to code inside a nested `for` or `if` that opens its own scope.
*/
has_direct_code :: proc(nodes: []Node) -> bool {
	for node in nodes {
		switch n in node {
		case Text:
		case Expr:
			return true
		case ^Element:
			if !is_component(n.tag) {
				for attr in n.attrs {
					if attr.kind == .Expr || attr.kind == .Spread {
						return true
					}
				}
			}
			if has_direct_code(n.children[:]) {
				return true
			}
		case ^If:
			declares_vars := false
			for branch in n.branches {
				declares_vars ||= !branch.is_else && len(header_vars(branch.cond, false)) > 0
				if !declares_vars && has_direct_code(branch.body[:]) {
					return true
				}
			}
		case ^For:
		}
	}
	return false
}

// Declares a list holding `nodes` and returns the expression of its slice,
// or `nil` when there are no nodes.
gen_list :: proc(g: ^Gen, nodes: []Node) -> string {
	if len(nodes) == 0 {
		return "nil"
	}
	list := fmt.aprintf("_n%d", next_id(g))
	emit(g, "%s := make([dynamic]frigg.Node, 0, %d, allocator)", list, len(nodes))
	gen_nodes(g, nodes, list)
	return fmt.aprintf("%s[:]", list)
}

// Generates the code appending `nodes` to the dynamic array named `list`.
gen_nodes :: proc(g: ^Gen, nodes: []Node, list: string) {
	for node in nodes {
		switch n in node {
		case Text:
			emit(g, "append(&%s, frigg.Safe_String(%s))", list, quote(n.text))
		case Expr:
			emit(g, "append(&%s, %s)", list, gen_code(g, "Code", "frigg.Node", "frigg.to_node", n.code, n.line))
		case ^Element:
			if is_component(n.tag) {
				gen_component(g, n, list)
			} else {
				gen_element(g, n, list)
			}
		case ^If:
			gen_if(g, n, list)
		case ^For:
			emit(g, "for %s {{", n.header)
			g.indent += 1
			open_scope(g, header_vars(n.header, true)[:], n.body[:])
			gen_nodes(g, n.body[:], list)
			close_scope(g)
			g.indent -= 1
			emit(g, "}}")
		}
	}
}

gen_if :: proc(g: ^Gen, node: ^If, list: string) {
	// Variables declared by a branch (`if value, ok := m[key]; ok`) are also
	// visible in the branches that follow it.
	vars: [dynamic]string
	for branch, i in node.branches {
		switch {
		case branch.is_else: emit(g, "}} else {{")
		case i == 0:         emit(g, "if %s {{", branch.cond)
		case:                emit(g, "}} else if %s {{", branch.cond)
		}
		if !branch.is_else {
			append(&vars, ..header_vars(branch.cond, false)[:])
		}
		g.indent += 1
		if len(vars) > 0 {
			open_scope(g, vars[:], branch.body[:])
		}
		gen_nodes(g, branch.body[:], list)
		if len(vars) > 0 {
			close_scope(g)
		}
		g.indent -= 1
	}
	emit(g, "}}")
}

gen_element :: proc(g: ^Gen, elem: ^Element, list: string) {
	attributes := "nil"
	if len(elem.attrs) > 0 {
		attributes = fmt.aprintf("_a%d", next_id(g))
		emit(g, "%s := make([]frigg.Attribute, %d, allocator)", attributes, len(elem.attrs))
		for attr, i in elem.attrs {
			value: string
			switch attr.kind {
			case .Static:
				// Values are always written between double quotes.
				escaped, _ := strings.replace_all(attr.value, "\"", "&quot;")
				value = fmt.aprintf("frigg.Safe_String(%s)", quote(escaped))
			case .Bare:
				value = "true"
			case .Expr:
				value = gen_code(g, "Code", "frigg.Node", "frigg.to_node", attr.value, attr.line)
			case .Spread:
				value = gen_code(g, "Spread", "[]frigg.Attribute", "frigg.to_attributes", attr.value, attr.line)
			}
			emit(g, "%s[%d] = {{%s, %s}}", attributes, i, quote(attr.name), value)
		}
	}
	children := gen_list(g, elem.children[:])
	emit(g, "append(&%s, frigg.element(%s, %s, %s, %v, allocator))", list, quote(elem.tag), attributes, children, elem.void)
}

// `<.card title={title}>...</.card>` calls `card(title = title, children = ...)`.
gen_component :: proc(g: ^Gen, elem: ^Element, list: string) {
	call: strings.Builder
	fmt.sbprintf(&call, "%s(", strings.trim_prefix(elem.tag, "."))
	for attr in elem.attrs {
		value: string
		switch attr.kind {
		case .Static:        value = quote(attr.value)
		case .Bare:          value = "true"
		case .Expr, .Spread: value = attr.value
		}
		fmt.sbprintf(&call, "%s = %s, ", attr.name, value)
	}
	if len(elem.children) > 0 {
		fmt.sbprintf(&call, "children = %s, ", gen_list(g, elem.children[:]))
	}
	strings.write_string(&call, "allocator = allocator)")
	emit(g, "append(&%s, frigg.to_node(%s))", list, strings.to_string(call))
}

/*
Returns a `frigg.Code` or `frigg.Spread` literal wrapping `code` in a
procedure that has access to the variables of the current scope.
*/
gen_code :: proc(g: ^Gen, type, result, convert, code: string, line: int) -> string {
	scope := g.scopes[len(g.scopes) - 1]
	sb: strings.Builder
	indent := strings.repeat("\t", g.indent)
	param := "_p" if scope.env_type != "" else "_"
	fmt.sbprintf(&sb, "frigg.%s{{proc(%s: rawptr) -> %s {{ // %s:%d\n", type, param, result, g.file, line)
	if scope.env_type != "" {
		fmt.sbprintf(&sb, "%s\tusing _e := (^%s)(_p)\n", indent, scope.env_type)
	}
	if strings.contains(code, "\n") || strings.contains(code, "//") {
		fmt.sbprintf(&sb, "%s\treturn %s(\n%s\t\t%s,\n%s\t)\n", indent, convert, indent, code, indent)
	} else {
		fmt.sbprintf(&sb, "%s\treturn %s(%s)\n", indent, convert, code)
	}
	fmt.sbprintf(&sb, "%s}}, %s}}", indent, scope.env_var if scope.env_type != "" else "nil")
	return strings.to_string(sb)
}

// Returns `s` as an Odin string literal.
quote :: proc(s: string) -> string {
	sb: strings.Builder
	strings.write_byte(&sb, '"')
	for i in 0 ..< len(s) {
		switch c := s[i]; c {
		case '"':  strings.write_string(&sb, "\\\"")
		case '\\': strings.write_string(&sb, "\\\\")
		case '\n': strings.write_string(&sb, "\\n")
		case '\r': strings.write_string(&sb, "\\r")
		case '\t': strings.write_string(&sb, "\\t")
		case:
			if c < 0x20 || c == 0x7f {
				fmt.sbprintf(&sb, "\\x%02x", c)
			} else {
				strings.write_byte(&sb, c)
			}
		}
	}
	strings.write_byte(&sb, '"')
	return strings.to_string(sb)
}
